# Shared image for all worker types (ingestion/audience/rotation/dispatch-*/
# message-events/retry-scheduler/outbox-relay/analytics/scheduler). Which
# loop runs is selected at container-start via the WORKER_TYPE env var, set
# per-service in docker-compose.yml - keeps the Dockerfile/image count small
# per the requirements doc's "don't necessarily create a separate container
# image for every logical function" guidance.
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    librdkafka-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --default-timeout=120 --retries=10 -r requirements.txt

FROM python:3.12-slim AS runtime

# See Dockerfile.backend for why (container-local time display only -
# TIMESTAMPTZ storage is already UTC regardless).
ENV TZ=Africa/Dar_es_Salaam

RUN apt-get update && apt-get install -y --no-install-recommends \
    librdkafka1 \
    tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 appuser

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY backend/app ./app

# See Dockerfile.backend - same reasoning: worker-ingestion also mounts the
# import storage volume and must be able to write/read it as appuser.
RUN mkdir -p /var/lib/campaign-engine/imports/uploads && \
    chown -R appuser:appuser /var/lib/campaign-engine

USER appuser

CMD ["python", "-m", "app.workers.stub_runner"]
