# Copy to .env and fill in real values. .env is git-ignored - never commit
# real credentials (see docs/decisions.md security note).

ENVIRONMENT=production

# Container-local timezone (log lines, any local-time display) - business
# timestamps are TIMESTAMPTZ and stored UTC regardless of this value.
TZ=Africa/Dar_es_Salaam

# --- Existing AfyaCall PostgreSQL (reused, never a second database) ---
# Use the least-privilege `campaign_app` role created by
# deploy/scripts/bootstrap_db.sh, NOT a superuser account.
POSTGRES_HOST=192.168.1.11
POSTGRES_PORT=5432
POSTGRES_DB=afyacall
POSTGRES_USER=campaign_app
POSTGRES_PASSWORD=change-me

# --- Redis (containerized, internal Docker network only) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka (containerized, internal Docker network only) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Existing Kannel gateway on the host (never containerized here) ---
KANNEL_HOST=192.168.1.10
KANNEL_PORTS=6016,6017,6018
KANNEL_USERNAME=change-me
KANNEL_PASSWORD=change-me

# --- Global rate limit (hard constraint: SMS + IVR + Doctor <= this) ---
GLOBAL_TPS_LIMIT=200
SMS_TPS_ALLOCATION=140
IVR_TPS_ALLOCATION=40
DOCTOR_TPS_ALLOCATION=20

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-value

# --- Server-side import drop path (inside the backend/worker containers) ---
SERVER_DROP_PATH=/data/campaign/incoming
